cells:
  - kind: 2
    value: "-- ================================================================\r

      -- Blood Donation System - Oracle Database 21c\r

      -- 1. Reference / identity tables\r

      -- ================================================================\r

      \r

      CREATE TABLE APP_USER (\r

      \    USER_ID              NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    USERNAME             VARCHAR2(100 CHAR) NOT NULL,\r

      \    EMAIL                VARCHAR2(255 CHAR),\r

      \    PASSWORD_HASH        VARCHAR2(500 CHAR) NOT NULL,\r

      \    ACCOUNT_STATUS       VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    UPDATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    LAST_LOGIN_AT        TIMESTAMP WITH LOCAL TIME ZONE,\r

      \r

      \    CONSTRAINT PK_APP_USER PRIMARY KEY (USER_ID),\r

      \    CONSTRAINT UQ_APP_USER_USERNAME UNIQUE (USERNAME),\r

      \    CONSTRAINT UQ_APP_USER_EMAIL UNIQUE (EMAIL),\r

      \    CONSTRAINT CK_APP_USER_STATUS CHECK (\r

      \        ACCOUNT_STATUS IN ('ACTIVE', 'INACTIVE', 'LOCKED', 'SUSPENDED',
      'DISABLED')\r

      \    )\r

      );\r

      \r

      CREATE TABLE BLOOD_BANK (\r

      \    BLOOD_BANK_ID        NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    BANK_CODE            VARCHAR2(30 CHAR) NOT NULL,\r

      \    BANK_NAME            VARCHAR2(200 CHAR) NOT NULL,\r

      \    PHONE                VARCHAR2(30 CHAR),\r

      \    EMAIL                VARCHAR2(255 CHAR),\r

      \    ADDRESS              VARCHAR2(500 CHAR),\r

      \    LATITUDE             NUMBER(9,6),\r

      \    LONGITUDE            NUMBER(9,6),\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_BLOOD_BANK PRIMARY KEY (BLOOD_BANK_ID),\r

      \    CONSTRAINT UQ_BLOOD_BANK_CODE UNIQUE (BANK_CODE),\r

      \    CONSTRAINT CK_BLOOD_BANK_STATUS CHECK (STATUS IN ('ACTIVE',
      'INACTIVE')),\r

      \    CONSTRAINT CK_BLOOD_BANK_LAT CHECK (LATITUDE IS NULL OR LATITUDE
      BETWEEN -90 AND 90),\r

      \    CONSTRAINT CK_BLOOD_BANK_LON CHECK (LONGITUDE IS NULL OR LONGITUDE
      BETWEEN -180 AND 180)\r

      );\r

      \r

      CREATE TABLE ORGANIZING_COMMITTEE (\r

      \    COMMITTEE_ID         NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    COMMITTEE_CODE       VARCHAR2(30 CHAR) NOT NULL,\r

      \    COMMITTEE_NAME       VARCHAR2(200 CHAR) NOT NULL,\r

      \    PHONE                VARCHAR2(30 CHAR),\r

      \    EMAIL                VARCHAR2(255 CHAR),\r

      \    ADDRESS              VARCHAR2(500 CHAR),\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_ORGANIZING_COMMITTEE PRIMARY KEY (COMMITTEE_ID),\r

      \    CONSTRAINT UQ_COMMITTEE_CODE UNIQUE (COMMITTEE_CODE),\r

      \    CONSTRAINT CK_COMMITTEE_STATUS CHECK (STATUS IN ('ACTIVE',
      'INACTIVE'))\r

      );\r

      \r

      CREATE TABLE USER_ROLE_LINK (\r

      \    USER_ROLE_ID         NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    USER_ID              NUMBER NOT NULL,\r

      \    ROLE_CODE            VARCHAR2(30 CHAR) NOT NULL,\r

      \    DONOR_ID             NUMBER,\r

      \    BLOOD_BANK_ID        NUMBER,\r

      \    COMMITTEE_ID         NUMBER,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_USER_ROLE_LINK PRIMARY KEY (USER_ROLE_ID),\r

      \    CONSTRAINT UQ_USER_ROLE_LINK_USER UNIQUE (USER_ID),\r

      \    CONSTRAINT CK_USER_ROLE_LINK_ROLE CHECK (\r

      \        ROLE_CODE IN ('DONOR', 'BLOOD_BANK', 'ORGANIZING_COMMITTEE',
      'WEBMASTER')\r

      \    ),\r

      \    CONSTRAINT CK_USER_ROLE_LINK_ENTITY CHECK (\r

      \        (ROLE_CODE = 'DONOR'\r

      \            AND DONOR_ID IS NOT NULL\r

      \            AND BLOOD_BANK_ID IS NULL\r

      \            AND COMMITTEE_ID IS NULL)\r

      \        OR\r

      \        (ROLE_CODE = 'BLOOD_BANK'\r

      \            AND DONOR_ID IS NULL\r

      \            AND BLOOD_BANK_ID IS NOT NULL\r

      \            AND COMMITTEE_ID IS NULL)\r

      \        OR\r

      \        (ROLE_CODE = 'ORGANIZING_COMMITTEE'\r

      \            AND DONOR_ID IS NULL\r

      \            AND BLOOD_BANK_ID IS NULL\r

      \            AND COMMITTEE_ID IS NOT NULL)\r

      \        OR\r

      \        (ROLE_CODE = 'WEBMASTER'\r

      \            AND DONOR_ID IS NULL\r

      \            AND BLOOD_BANK_ID IS NULL\r

      \            AND COMMITTEE_ID IS NULL)\r

      \    ),\r

      \    CONSTRAINT FK_USER_ROLE_USER FOREIGN KEY (USER_ID) REFERENCES
      APP_USER(USER_ID),\r

      \    CONSTRAINT FK_USER_ROLE_BANK FOREIGN KEY (BLOOD_BANK_ID) REFERENCES
      BLOOD_BANK(BLOOD_BANK_ID),\r

      \    CONSTRAINT FK_USER_ROLE_COMMITTEE FOREIGN KEY (COMMITTEE_ID)
      REFERENCES ORGANIZING_COMMITTEE(COMMITTEE_ID)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- 2. Donor\r

      -- Depends on: 01_reference_identity.sql\r

      \r

      CREATE TABLE DONOR (\r

      \    DONOR_ID             NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    USER_ID              NUMBER NOT NULL,\r

      \    FULL_NAME            VARCHAR2(200 CHAR) NOT NULL,\r

      \    NIC                  VARCHAR2(30 CHAR) NOT NULL,\r

      \    DATE_OF_BIRTH        DATE NOT NULL,\r

      \    GENDER               VARCHAR2(20 CHAR),\r

      \    BLOOD_GROUP          VARCHAR2(3 CHAR),\r

      \    PHONE                VARCHAR2(30 CHAR),\r

      \    EMAIL                VARCHAR2(255 CHAR),\r

      \    ADDRESS              VARCHAR2(500 CHAR),\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    UPDATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_DONOR PRIMARY KEY (DONOR_ID),\r

      \    CONSTRAINT UQ_DONOR_USER UNIQUE (USER_ID),\r

      \    CONSTRAINT UQ_DONOR_NIC UNIQUE (NIC),\r

      \    CONSTRAINT CK_DONOR_BLOOD_GROUP CHECK (\r

      \        BLOOD_GROUP IS NULL OR BLOOD_GROUP IN ('A+', 'A-', 'B+', 'B-',
      'AB+', 'AB-', 'O+', 'O-')\r

      \    ),\r

      \    CONSTRAINT CK_DONOR_GENDER CHECK (\r

      \        GENDER IS NULL OR GENDER IN ('MALE', 'FEMALE', 'OTHER',
      'PREFER_NOT_TO_SAY')\r

      \    ),\r

      \    CONSTRAINT CK_DONOR_STATUS CHECK (\r

      \        STATUS IN ('ACTIVE', 'INACTIVE', 'SUSPENDED')\r

      \    ),\r

      \    CONSTRAINT FK_DONOR_USER FOREIGN KEY (USER_ID) REFERENCES
      APP_USER(USER_ID)\r

      );\r

      \r

      ALTER TABLE USER_ROLE_LINK\r

      \    ADD CONSTRAINT FK_USER_ROLE_DONOR FOREIGN KEY (DONOR_ID) REFERENCES
      DONOR(DONOR_ID);\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- 3. Venues and camps\r

      -- Depends on: 01_reference_identity.sql\r

      \r

      CREATE TABLE VENUE (\r

      \    VENUE_ID             NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    COMMITTEE_ID         NUMBER NOT NULL,\r

      \    VENUE_NAME           VARCHAR2(200 CHAR) NOT NULL,\r

      \    ADDRESS              VARCHAR2(500 CHAR) NOT NULL,\r

      \    LATITUDE             NUMBER(9,6),\r

      \    LONGITUDE            NUMBER(9,6),\r

      \    CAPACITY             NUMBER(8) NOT NULL,\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    UPDATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_VENUE PRIMARY KEY (VENUE_ID),\r

      \    CONSTRAINT CK_VENUE_CAPACITY CHECK (CAPACITY > 0),\r

      \    CONSTRAINT CK_VENUE_LAT CHECK (LATITUDE IS NULL OR LATITUDE BETWEEN
      -90 AND 90),\r

      \    CONSTRAINT CK_VENUE_LON CHECK (LONGITUDE IS NULL OR LONGITUDE BETWEEN
      -180 AND 180),\r

      \    CONSTRAINT CK_VENUE_STATUS CHECK (STATUS IN ('ACTIVE',
      'INACTIVE')),\r

      \    CONSTRAINT FK_VENUE_COMMITTEE FOREIGN KEY (COMMITTEE_ID)\r

      \        REFERENCES ORGANIZING_COMMITTEE(COMMITTEE_ID)\r

      );\r

      \r

      CREATE TABLE DONATION_CAMP (\r

      \    CAMP_ID              NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    COMMITTEE_ID         NUMBER NOT NULL,\r

      \    VENUE_ID             NUMBER NOT NULL,\r

      \    CAMP_TITLE           VARCHAR2(250 CHAR) NOT NULL,\r

      \    CAMP_DESCRIPTION     CLOB,\r

      \    CAMP_DATE            DATE NOT NULL,\r

      \    START_TIME           TIMESTAMP NOT NULL,\r

      \    END_TIME             TIMESTAMP NOT NULL,\r

      \    CAPACITY             NUMBER(8) NOT NULL,\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'DRAFT' NOT NULL,\r

      \    PUBLIC_VISIBLE       CHAR(1) DEFAULT 'N' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    UPDATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_DONATION_CAMP PRIMARY KEY (CAMP_ID),\r

      \    CONSTRAINT CK_CAMP_CAPACITY CHECK (CAPACITY > 0),\r

      \    CONSTRAINT CK_CAMP_TIME CHECK (END_TIME > START_TIME),\r

      \    CONSTRAINT CK_CAMP_STATUS CHECK (\r

      \        STATUS IN ('DRAFT', 'PUBLISHED', 'ONGOING', 'COMPLETED',
      'CANCELLED', 'CLOSED')\r

      \    ),\r

      \    CONSTRAINT CK_CAMP_PUBLIC_VISIBLE CHECK (PUBLIC_VISIBLE IN ('Y',
      'N')),\r

      \    CONSTRAINT FK_CAMP_COMMITTEE FOREIGN KEY (COMMITTEE_ID)\r

      \        REFERENCES ORGANIZING_COMMITTEE(COMMITTEE_ID),\r

      \    CONSTRAINT FK_CAMP_VENUE FOREIGN KEY (VENUE_ID)\r

      \        REFERENCES VENUE(VENUE_ID)\r

      );\r

      \r

      CREATE TABLE CAMP_TARGET_BLOOD_GROUP (\r

      \    CAMP_TARGET_ID       NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    CAMP_ID              NUMBER NOT NULL,\r

      \    BLOOD_GROUP          VARCHAR2(3 CHAR) NOT NULL,\r

      \r

      \    CONSTRAINT PK_CAMP_TARGET_BLOOD_GROUP PRIMARY KEY (CAMP_TARGET_ID),\r

      \    CONSTRAINT UQ_CAMP_TARGET_BLOOD_GROUP UNIQUE (CAMP_ID,
      BLOOD_GROUP),\r

      \    CONSTRAINT CK_CAMP_TARGET_BLOOD_GROUP CHECK (\r

      \        BLOOD_GROUP IN ('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+',
      'O-')\r

      \    ),\r

      \    CONSTRAINT FK_CAMP_TARGET_CAMP FOREIGN KEY (CAMP_ID)\r

      \        REFERENCES DONATION_CAMP(CAMP_ID)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- 4. Camp donor registration / attendance\r

      -- Depends on: 02_donor.sql, 03_venues_and_camps.sql\r

      \r

      CREATE TABLE CAMP_REGISTRATION (\r

      \    REGISTRATION_ID      NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    CAMP_ID              NUMBER NOT NULL,\r

      \    DONOR_ID             NUMBER NOT NULL,\r

      \    REGISTERED_AT        TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    REGISTRATION_STATUS  VARCHAR2(20 CHAR) DEFAULT 'REGISTERED' NOT
      NULL,\r

      \    ATTENDANCE_STATUS    VARCHAR2(20 CHAR) DEFAULT 'EXPECTED' NOT NULL,\r

      \    CHECK_IN_AT          TIMESTAMP WITH LOCAL TIME ZONE,\r

      \    CHECK_OUT_AT         TIMESTAMP WITH LOCAL TIME ZONE,\r

      \r

      \    CONSTRAINT PK_CAMP_REGISTRATION PRIMARY KEY (REGISTRATION_ID),\r

      \    CONSTRAINT UQ_CAMP_DONOR_REGISTRATION UNIQUE (CAMP_ID, DONOR_ID),\r

      \    CONSTRAINT CK_CAMP_REG_STATUS CHECK (\r

      \        REGISTRATION_STATUS IN ('REGISTERED', 'CANCELLED', 'WAITLISTED',
      'CLOSED')\r

      \    ),\r

      \    CONSTRAINT CK_CAMP_ATTENDANCE_STATUS CHECK (\r

      \        ATTENDANCE_STATUS IN ('EXPECTED', 'CHECKED_IN', 'NO_SHOW',
      'COMPLETED')\r

      \    ),\r

      \    CONSTRAINT FK_CAMP_REG_CAMP FOREIGN KEY (CAMP_ID)\r

      \        REFERENCES DONATION_CAMP(CAMP_ID),\r

      \    CONSTRAINT FK_CAMP_REG_DONOR FOREIGN KEY (DONOR_ID)\r

      \        REFERENCES DONOR(DONOR_ID)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- 5. Donation records\r

      -- Depends on: 04_camp_registration.sql, 03_venues_and_camps.sql,
      02_donor.sql\r

      \r

      CREATE TABLE DONATION_RECORD (\r

      \    DONATION_ID          NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    REGISTRATION_ID      NUMBER NOT NULL,\r

      \    CAMP_ID              NUMBER NOT NULL,\r

      \    DONOR_ID             NUMBER NOT NULL,\r

      \    DONATION_DATE        DATE NOT NULL,\r

      \    BLOOD_GROUP          VARCHAR2(3 CHAR) NOT NULL,\r

      \    UNITS_COLLECTED      NUMBER(4,1) DEFAULT 1 NOT NULL,\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'DRAFT' NOT NULL,\r

      \    NOTES                CLOB,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    SUBMITTED_AT         TIMESTAMP WITH LOCAL TIME ZONE,\r

      \r

      \    CONSTRAINT PK_DONATION_RECORD PRIMARY KEY (DONATION_ID),\r

      \    CONSTRAINT CK_DONATION_BLOOD_GROUP CHECK (\r

      \        BLOOD_GROUP IN ('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+',
      'O-')\r

      \    ),\r

      \    CONSTRAINT CK_DONATION_UNITS CHECK (UNITS_COLLECTED > 0),\r

      \    CONSTRAINT CK_DONATION_STATUS CHECK (\r

      \        STATUS IN ('DRAFT', 'SUBMITTED', 'CANCELLED')\r

      \    ),\r

      \    CONSTRAINT FK_DONATION_REGISTRATION FOREIGN KEY (REGISTRATION_ID)\r

      \        REFERENCES CAMP_REGISTRATION(REGISTRATION_ID),\r

      \    CONSTRAINT FK_DONATION_CAMP FOREIGN KEY (CAMP_ID)\r

      \        REFERENCES DONATION_CAMP(CAMP_ID),\r

      \    CONSTRAINT FK_DONATION_DONOR FOREIGN KEY (DONOR_ID)\r

      \        REFERENCES DONOR(DONOR_ID)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- 6. Staff\r

      -- Depends on: 01_reference_identity.sql, 03_venues_and_camps.sql\r

      \r

      CREATE TABLE STAFF_MEMBER (\r

      \    STAFF_ID             NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    USER_ID              NUMBER,\r

      \    FULL_NAME            VARCHAR2(200 CHAR) NOT NULL,\r

      \    POSITION_TITLE       VARCHAR2(150 CHAR),\r

      \    PHONE                VARCHAR2(30 CHAR),\r

      \    EMAIL                VARCHAR2(255 CHAR),\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_STAFF_MEMBER PRIMARY KEY (STAFF_ID),\r

      \    CONSTRAINT UQ_STAFF_USER UNIQUE (USER_ID),\r

      \    CONSTRAINT CK_STAFF_STATUS CHECK (STATUS IN ('ACTIVE',
      'INACTIVE')),\r

      \    CONSTRAINT FK_STAFF_USER FOREIGN KEY (USER_ID) REFERENCES
      APP_USER(USER_ID)\r

      );\r

      \r

      CREATE TABLE BANK_STAFF_ASSIGNMENT (\r

      \    BANK_STAFF_ASSIGNMENT_ID NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    STAFF_ID             NUMBER NOT NULL,\r

      \    BLOOD_BANK_ID        NUMBER NOT NULL,\r

      \    ASSIGNED_FROM        DATE NOT NULL,\r

      \    ASSIGNED_TO          DATE,\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \r

      \    CONSTRAINT PK_BANK_STAFF_ASSIGNMENT PRIMARY KEY
      (BANK_STAFF_ASSIGNMENT_ID),\r

      \    CONSTRAINT CK_BANK_STAFF_DATES CHECK (ASSIGNED_TO IS NULL OR
      ASSIGNED_TO >= ASSIGNED_FROM),\r

      \    CONSTRAINT CK_BANK_STAFF_STATUS CHECK (STATUS IN ('ACTIVE',
      'INACTIVE')),\r

      \    CONSTRAINT FK_BANK_STAFF_STAFF FOREIGN KEY (STAFF_ID) REFERENCES
      STAFF_MEMBER(STAFF_ID),\r

      \    CONSTRAINT FK_BANK_STAFF_BANK FOREIGN KEY (BLOOD_BANK_ID) REFERENCES
      BLOOD_BANK(BLOOD_BANK_ID)\r

      );\r

      \r

      CREATE TABLE COMMITTEE_STAFF_ASSIGNMENT (\r

      \    COMMITTEE_STAFF_ASSIGNMENT_ID NUMBER GENERATED BY DEFAULT AS
      IDENTITY,\r

      \    STAFF_ID             NUMBER NOT NULL,\r

      \    COMMITTEE_ID         NUMBER NOT NULL,\r

      \    ASSIGNED_FROM        DATE NOT NULL,\r

      \    ASSIGNED_TO          DATE,\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \r

      \    CONSTRAINT PK_COMMITTEE_STAFF_ASSIGNMENT PRIMARY KEY
      (COMMITTEE_STAFF_ASSIGNMENT_ID),\r

      \    CONSTRAINT CK_COMMITTEE_STAFF_DATES CHECK (ASSIGNED_TO IS NULL OR
      ASSIGNED_TO >= ASSIGNED_FROM),\r

      \    CONSTRAINT CK_COMMITTEE_STAFF_STATUS CHECK (STATUS IN ('ACTIVE',
      'INACTIVE')),\r

      \    CONSTRAINT FK_COMMITTEE_STAFF_STAFF FOREIGN KEY (STAFF_ID) REFERENCES
      STAFF_MEMBER(STAFF_ID),\r

      \    CONSTRAINT FK_COMMITTEE_STAFF_COMMITTEE FOREIGN KEY (COMMITTEE_ID)\r

      \        REFERENCES ORGANIZING_COMMITTEE(COMMITTEE_ID)\r

      );\r

      \r

      CREATE TABLE CAMP_STAFF_ASSIGNMENT (\r

      \    CAMP_STAFF_ASSIGNMENT_ID NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    CAMP_ID              NUMBER NOT NULL,\r

      \    STAFF_ID             NUMBER NOT NULL,\r

      \    ASSIGNMENT_ROLE      VARCHAR2(100 CHAR),\r

      \    ASSIGNED_FROM        TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    ASSIGNED_TO          TIMESTAMP WITH LOCAL TIME ZONE,\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \r

      \    CONSTRAINT PK_CAMP_STAFF_ASSIGNMENT PRIMARY KEY
      (CAMP_STAFF_ASSIGNMENT_ID),\r

      \    CONSTRAINT CK_CAMP_STAFF_DATES CHECK (\r

      \        ASSIGNED_TO IS NULL OR ASSIGNED_TO >= ASSIGNED_FROM\r

      \    ),\r

      \    CONSTRAINT CK_CAMP_STAFF_STATUS CHECK (STATUS IN ('ACTIVE',
      'INACTIVE')),\r

      \    CONSTRAINT FK_CAMP_STAFF_CAMP FOREIGN KEY (CAMP_ID) REFERENCES
      DONATION_CAMP(CAMP_ID),\r

      \    CONSTRAINT FK_CAMP_STAFF_STAFF FOREIGN KEY (STAFF_ID) REFERENCES
      STAFF_MEMBER(STAFF_ID)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- 7. Donation transfer to blood bank\r

      -- Depends on: 03_venues_and_camps.sql, 05_donation_records.sql\r

      \r

      CREATE TABLE DONATION_TRANSFER (\r

      \    TRANSFER_ID          NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    CAMP_ID              NUMBER NOT NULL,\r

      \    COMMITTEE_ID         NUMBER NOT NULL,\r

      \    BLOOD_BANK_ID        NUMBER NOT NULL,\r

      \    TRANSFER_CODE        VARCHAR2(40 CHAR) NOT NULL,\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'PREPARED' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    DISPATCHED_AT        TIMESTAMP WITH LOCAL TIME ZONE,\r

      \    RECEIVED_AT          TIMESTAMP WITH LOCAL TIME ZONE,\r

      \    RECEIVED_UNIT_COUNT  NUMBER(8,1),\r

      \    NOTES                CLOB,\r

      \r

      \    CONSTRAINT PK_DONATION_TRANSFER PRIMARY KEY (TRANSFER_ID),\r

      \    CONSTRAINT UQ_DONATION_TRANSFER_CODE UNIQUE (TRANSFER_CODE),\r

      \    CONSTRAINT CK_TRANSFER_STATUS CHECK (\r

      \        STATUS IN ('PREPARED', 'DISPATCHED', 'IN_TRANSIT', 'RECEIVED',
      'CANCELLED')\r

      \    ),\r

      \    CONSTRAINT CK_TRANSFER_RECEIVED_COUNT CHECK (\r

      \        RECEIVED_UNIT_COUNT IS NULL OR RECEIVED_UNIT_COUNT >= 0\r

      \    ),\r

      \    CONSTRAINT FK_TRANSFER_CAMP FOREIGN KEY (CAMP_ID) REFERENCES
      DONATION_CAMP(CAMP_ID),\r

      \    CONSTRAINT FK_TRANSFER_COMMITTEE FOREIGN KEY (COMMITTEE_ID)\r

      \        REFERENCES ORGANIZING_COMMITTEE(COMMITTEE_ID),\r

      \    CONSTRAINT FK_TRANSFER_BANK FOREIGN KEY (BLOOD_BANK_ID)\r

      \        REFERENCES BLOOD_BANK(BLOOD_BANK_ID)\r

      );\r

      \r

      CREATE TABLE DONATION_TRANSFER_ITEM (\r

      \    TRANSFER_ITEM_ID     NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    TRANSFER_ID          NUMBER NOT NULL,\r

      \    DONATION_ID          NUMBER NOT NULL,\r

      \    UNITS_TRANSFERRED    NUMBER(4,1) DEFAULT 1 NOT NULL,\r

      \r

      \    CONSTRAINT PK_DONATION_TRANSFER_ITEM PRIMARY KEY
      (TRANSFER_ITEM_ID),\r

      \    CONSTRAINT UQ_TRANSFER_DONATION UNIQUE (TRANSFER_ID, DONATION_ID),\r

      \    CONSTRAINT CK_TRANSFER_ITEM_UNITS CHECK (UNITS_TRANSFERRED > 0),\r

      \    CONSTRAINT FK_TRANSFER_ITEM_TRANSFER FOREIGN KEY (TRANSFER_ID)\r

      \        REFERENCES DONATION_TRANSFER(TRANSFER_ID),\r

      \    CONSTRAINT FK_TRANSFER_ITEM_DONATION FOREIGN KEY (DONATION_ID)\r

      \        REFERENCES DONATION_RECORD(DONATION_ID)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- ----------------------------------------------------------------\r

      -- 8. Blood inventory\r

      -- ----------------------------------------------------------------\r

      \r

      CREATE TABLE BLOOD_UNIT (\r

      \    BLOOD_UNIT_ID        NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    BLOOD_BANK_ID        NUMBER NOT NULL,\r

      \    DONATION_ID          NUMBER NOT NULL,\r

      \    TRANSFER_ID          NUMBER NOT NULL,\r

      \    UNIT_CODE            VARCHAR2(50 CHAR) NOT NULL,\r

      \    BLOOD_GROUP          VARCHAR2(3 CHAR) NOT NULL,\r

      \    COLLECTION_DATE      DATE NOT NULL,\r

      \    RECEIVED_DATE        DATE,\r

      \    EXPIRY_DATE          DATE NOT NULL,\r

      \    STATUS               VARCHAR2(25 CHAR) DEFAULT 'AVAILABLE' NOT
      NULL,\r

      \    STORAGE_LOCATION     VARCHAR2(150 CHAR),\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    UPDATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_BLOOD_UNIT PRIMARY KEY (BLOOD_UNIT_ID),\r

      \    CONSTRAINT UQ_BLOOD_UNIT_CODE UNIQUE (UNIT_CODE),\r

      \    CONSTRAINT CK_BLOOD_UNIT_GROUP CHECK (\r

      \        BLOOD_GROUP IN ('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+',
      'O-')\r

      \    ),\r

      \    CONSTRAINT CK_BLOOD_UNIT_DATES CHECK (EXPIRY_DATE >
      COLLECTION_DATE),\r

      \    CONSTRAINT CK_BLOOD_UNIT_STATUS CHECK (\r

      \        STATUS IN (\r

      \            'AVAILABLE',\r

      \            'RESERVED',\r

      \            'ALLOCATED',\r

      \            'ISSUED',\r

      \            'EXPIRED',\r

      \            'UNAVAILABLE'\r

      \        )\r

      \    ),\r

      \    CONSTRAINT FK_BLOOD_UNIT_BANK FOREIGN KEY (BLOOD_BANK_ID)\r

      \        REFERENCES BLOOD_BANK(BLOOD_BANK_ID),\r

      \    CONSTRAINT FK_BLOOD_UNIT_DONATION FOREIGN KEY (DONATION_ID)\r

      \        REFERENCES DONATION_RECORD(DONATION_ID),\r

      \    CONSTRAINT FK_BLOOD_UNIT_TRANSFER FOREIGN KEY (TRANSFER_ID)\r

      \        REFERENCES DONATION_TRANSFER(TRANSFER_ID)\r

      );"
    languageId: oracle-sql
  - kind: 2
    value: "-- 9. Hospitals and hospital blood requests\r

      -- Depends on: 01_reference_identity.sql, 08_blood_inventory.sql\r

      \r

      CREATE TABLE HOSPITAL (\r

      \    HOSPITAL_ID          NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    HOSPITAL_CODE        VARCHAR2(40 CHAR) NOT NULL,\r

      \    HOSPITAL_NAME        VARCHAR2(250 CHAR) NOT NULL,\r

      \    CONTACT_PERSON       VARCHAR2(200 CHAR),\r

      \    PHONE                VARCHAR2(30 CHAR),\r

      \    EMAIL                VARCHAR2(255 CHAR),\r

      \    ADDRESS              VARCHAR2(500 CHAR),\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'ACTIVE' NOT NULL,\r

      \r

      \    CONSTRAINT PK_HOSPITAL PRIMARY KEY (HOSPITAL_ID),\r

      \    CONSTRAINT UQ_HOSPITAL_CODE UNIQUE (HOSPITAL_CODE),\r

      \    CONSTRAINT CK_HOSPITAL_STATUS CHECK (STATUS IN ('ACTIVE',
      'INACTIVE'))\r

      );\r

      \r

      CREATE TABLE HOSPITAL_BLOOD_REQUEST (\r

      \    REQUEST_ID           NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    REQUEST_CODE         VARCHAR2(40 CHAR) NOT NULL,\r

      \    HOSPITAL_ID          NUMBER NOT NULL,\r

      \    BLOOD_BANK_ID        NUMBER NOT NULL,\r

      \    BLOOD_GROUP          VARCHAR2(3 CHAR) NOT NULL,\r

      \    UNITS_REQUIRED       NUMBER(8,1) NOT NULL,\r

      \    UNITS_ALLOCATED      NUMBER(8,1) DEFAULT 0 NOT NULL,\r

      \    UNITS_FULFILLED      NUMBER(8,1) DEFAULT 0 NOT NULL,\r

      \    NEEDED_BY            TIMESTAMP WITH LOCAL TIME ZONE NOT NULL,\r

      \    PRIORITY             VARCHAR2(15 CHAR) DEFAULT 'NORMAL' NOT NULL,\r

      \    STATUS               VARCHAR2(25 CHAR) DEFAULT 'PENDING' NOT NULL,\r

      \    NOTES                CLOB,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    UPDATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_HOSPITAL_BLOOD_REQUEST PRIMARY KEY (REQUEST_ID),\r

      \    CONSTRAINT UQ_HOSPITAL_REQUEST_CODE UNIQUE (REQUEST_CODE),\r

      \    CONSTRAINT CK_HOSPITAL_REQUEST_GROUP CHECK (\r

      \        BLOOD_GROUP IN ('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+',
      'O-')\r

      \    ),\r

      \    CONSTRAINT CK_HOSPITAL_REQUEST_UNITS CHECK (UNITS_REQUIRED > 0),\r

      \    CONSTRAINT CK_HOSPITAL_REQUEST_ALLOCATED CHECK (\r

      \        UNITS_ALLOCATED >= 0 AND UNITS_ALLOCATED <= UNITS_REQUIRED\r

      \    ),\r

      \    CONSTRAINT CK_HOSPITAL_REQUEST_FULFILLED CHECK (\r

      \        UNITS_FULFILLED >= 0 AND UNITS_FULFILLED <= UNITS_REQUIRED\r

      \        AND UNITS_FULFILLED <= UNITS_ALLOCATED\r

      \    ),\r

      \    CONSTRAINT CK_HOSPITAL_REQUEST_PRIORITY CHECK (\r

      \        PRIORITY IN ('LOW', 'NORMAL', 'HIGH', 'CRITICAL')\r

      \    ),\r

      \    CONSTRAINT CK_HOSPITAL_REQUEST_STATUS CHECK (\r

      \        STATUS IN ('PENDING', 'APPROVED', 'ALLOCATED',
      'PARTIALLY_FULFILLED',\r

      \                   'FULFILLED', 'CANCELLED', 'CLOSED')\r

      \    ),\r

      \    CONSTRAINT FK_HOSPITAL_REQUEST_HOSPITAL FOREIGN KEY (HOSPITAL_ID)\r

      \        REFERENCES HOSPITAL(HOSPITAL_ID),\r

      \    CONSTRAINT FK_HOSPITAL_REQUEST_BANK FOREIGN KEY (BLOOD_BANK_ID)\r

      \        REFERENCES BLOOD_BANK(BLOOD_BANK_ID)\r

      );\r

      \r

      CREATE TABLE HOSPITAL_REQUEST_ALLOCATION (\r

      \    ALLOCATION_ID        NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    REQUEST_ID           NUMBER NOT NULL,\r

      \    BLOOD_UNIT_ID        NUMBER NOT NULL,\r

      \    ALLOCATED_AT         TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    ISSUED_AT            TIMESTAMP WITH LOCAL TIME ZONE,\r

      \    STATUS               VARCHAR2(20 CHAR) DEFAULT 'RESERVED' NOT NULL,\r

      \r

      \    CONSTRAINT PK_HOSPITAL_REQUEST_ALLOCATION PRIMARY KEY
      (ALLOCATION_ID),\r

      \    CONSTRAINT UQ_HOSPITAL_REQUEST_UNIT UNIQUE (REQUEST_ID,
      BLOOD_UNIT_ID),\r

      \    CONSTRAINT CK_REQUEST_ALLOCATION_STATUS CHECK (\r

      \        STATUS IN ('RESERVED', 'ISSUED', 'CANCELLED')\r

      \    ),\r

      \    CONSTRAINT FK_REQUEST_ALLOC_REQUEST FOREIGN KEY (REQUEST_ID)\r

      \        REFERENCES HOSPITAL_BLOOD_REQUEST(REQUEST_ID),\r

      \    CONSTRAINT FK_REQUEST_ALLOC_UNIT FOREIGN KEY (BLOOD_UNIT_ID)\r

      \        REFERENCES BLOOD_UNIT(BLOOD_UNIT_ID)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- 10. Notifications\r

      -- Depends on: 01_reference_identity.sql\r

      \r

      CREATE TABLE NOTIFICATION (\r

      \    NOTIFICATION_ID      NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    USER_ID              NUMBER NOT NULL,\r

      \    NOTIFICATION_TYPE    VARCHAR2(50 CHAR) NOT NULL,\r

      \    TITLE                VARCHAR2(250 CHAR) NOT NULL,\r

      \    MESSAGE              CLOB NOT NULL,\r

      \    ENTITY_TYPE          VARCHAR2(50 CHAR),\r

      \    ENTITY_ID            NUMBER,\r

      \    ACTION_PATH          VARCHAR2(500 CHAR),\r

      \    IS_READ              CHAR(1) DEFAULT 'N' NOT NULL,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \    READ_AT              TIMESTAMP WITH LOCAL TIME ZONE,\r

      \r

      \    CONSTRAINT PK_NOTIFICATION PRIMARY KEY (NOTIFICATION_ID),\r

      \    CONSTRAINT CK_NOTIFICATION_READ CHECK (IS_READ IN ('Y', 'N')),\r

      \    CONSTRAINT FK_NOTIFICATION_USER FOREIGN KEY (USER_ID) REFERENCES
      APP_USER(USER_ID)\r

      );\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- 11. Workflow / audit history\r

      -- Depends on: 01_reference_identity.sql\r

      \r

      CREATE TABLE ENTITY_STATUS_HISTORY (\r

      \    STATUS_HISTORY_ID   NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    ENTITY_TYPE         VARCHAR2(50 CHAR) NOT NULL,\r

      \    ENTITY_ID           NUMBER NOT NULL,\r

      \    FROM_STATUS         VARCHAR2(50 CHAR),\r

      \    TO_STATUS           VARCHAR2(50 CHAR) NOT NULL,\r

      \    CHANGED_BY_USER_ID  NUMBER,\r

      \    REASON_CODE         VARCHAR2(100 CHAR),\r

      \    REASON_TEXT         VARCHAR2(1000 CHAR),\r

      \    CHANGED_AT          TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_ENTITY_STATUS_HISTORY PRIMARY KEY
      (STATUS_HISTORY_ID),\r

      \    CONSTRAINT FK_STATUS_HISTORY_USER FOREIGN KEY (CHANGED_BY_USER_ID)\r

      \        REFERENCES APP_USER(USER_ID)\r

      );\r

      \r

      CREATE TABLE AUDIT_LOG (\r

      \    AUDIT_ID             NUMBER GENERATED BY DEFAULT AS IDENTITY,\r

      \    ACTOR_USER_ID        NUMBER,\r

      \    ACTOR_ROLE_CODE      VARCHAR2(30 CHAR),\r

      \    ACTION_CODE          VARCHAR2(100 CHAR) NOT NULL,\r

      \    ENTITY_TYPE          VARCHAR2(50 CHAR),\r

      \    ENTITY_ID            NUMBER,\r

      \    RESULT_CODE          VARCHAR2(30 CHAR),\r

      \    DETAILS               CLOB,\r

      \    CREATED_AT           TIMESTAMP WITH LOCAL TIME ZONE DEFAULT
      SYSTIMESTAMP NOT NULL,\r

      \r

      \    CONSTRAINT PK_AUDIT_LOG PRIMARY KEY (AUDIT_ID),\r

      \    CONSTRAINT FK_AUDIT_LOG_USER FOREIGN KEY (ACTOR_USER_ID)\r

      \        REFERENCES APP_USER(USER_ID),\r

      \    CONSTRAINT CK_AUDIT_ROLE CHECK (\r

      \        ACTOR_ROLE_CODE IS NULL OR ACTOR_ROLE_CODE IN (\r

      \            'DONOR', 'BLOOD_BANK', 'ORGANIZING_COMMITTEE', 'WEBMASTER'\r

      \        )\r

      \    )\r

      );\r\n"
    languageId: oracle-sql
